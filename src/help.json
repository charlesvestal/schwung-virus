{
  "title": "Osirus",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Access Virus DSP",
        "emulator powered by",
        "Gearmulator.",
        "",
        "Requires Virus ROM",
        "files (.mid or .BIN)",
        "in the roms/ folder.",
        "",
        "Supports Virus A,",
        "B, and C ROMs.",
        "",
        "128 presets per bank,",
        "up to 32 banks."
      ]
    },
    {
      "title": "Setup",
      "lines": [
        "Copy Virus ROM files",
        "into the module's",
        "roms/ folder using",
        "the Schwung manager",
        "at move.local:7700.",
        "",
        "Supported formats:",
        " .mid (SysEx dump)",
        " .BIN (raw ROM)",
        "",
        "DSP clock is set",
        "automatically per",
        "model, to fit Move's",
        "CPU:",
        " Virus A: 100%",
        " Virus B: 45%",
        " Virus C: 35%",
        "",
        "Settings > DSP Clock",
        "overrides it, 10 to",
        "100%. Virus A is",
        "pinned at 100%.",
        "B/C values below",
        "their default reset",
        "to auto on reload."
      ]
    },
    {
      "title": "Controls",
      "children": [
        {
          "title": "Knob Mapping",
          "lines": [
            "Knob 1: Cutoff",
            "Knob 2: Resonance",
            "Knob 3: Filter Env",
            "Knob 4: Flt Attack",
            "Knob 5: Flt Decay",
            "Knob 6: Flt Sustain",
            "Knob 7: Flt Release",
            "Knob 8: Octave",
            " (-4 to +4)"
          ]
        },
        {
          "title": "Sections",
          "lines": [
            "The root menu also",
            "opens these pages:",
            "",
            " Bank",
            " Oscillators",
            " Filters",
            " Filter Env",
            " Amp Env",
            " LFO 1, LFO 2, LFO 3",
            " Arpeggiator",
            " Effects",
            " Mod Matrix",
            " Performance",
            " Settings",
            "",
            "Each has its own",
            "knobs and params.",
            "The pages below are",
            "a summary only."
          ]
        },
        {
          "title": "Filters",
          "lines": [
            "Cutoff: 0-127",
            "Resonance: 0-127",
            "Filter Env Amt:",
            " 0-127",
            "Filter Mode:",
            " 8 types (0-7)",
            "",
            "Filter envelope",
            "shapes cutoff over",
            "time with A/D/S/R",
            "controls."
          ]
        },
        {
          "title": "Amp Env",
          "lines": [
            "Attack: 0-127",
            "Decay: 0-127",
            "Sustain: 0-127",
            "Release: 0-127",
            "",
            "Controls amplitude",
            "shape of each note."
          ]
        },
        {
          "title": "Oscillators",
          "lines": [
            "Osc 1 Shape: 0-127",
            "Osc 2 Shape: 0-127",
            "Osc Balance: 0-127",
            "Volume: 0-127",
            "",
            "Shapes and balance",
            "between the two",
            "oscillators."
          ]
        },
        {
          "title": "Settings",
          "lines": [
            "ROM: select which",
            " Virus ROM to use",
            "",
            "DSP Clock %: 10-100",
            " CPU clock speed",
            " Lower = less CPU",
            " but reduced quality",
            "",
            "Gain %: 1-100",
            " Output level"
          ]
        }
      ]
    },
    {
      "title": "MIDI",
      "lines": [
        "Receives notes,",
        "CCs, pitch bend,",
        "and program changes.",
        "",
        "Octave Transpose:",
        " -4 to +4 octaves",
        "",
        "Bank Select:",
        " CC 0 / CC 32",
        "",
        "Program Change:",
        " Selects preset",
        " (0-127 per bank)"
      ]
    }
  ]
}
